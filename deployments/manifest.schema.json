{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProofOfPost deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "network", "chainId", "classification", "contractAddress", "deploymentTransaction", "deployer", "sourceHash", "deployedAt", "constructorArgs"],
  "properties": {
    "schemaVersion": { "const": 1 }, "project": { "const": "ProofOfPost" },
    "network": { "enum": ["studionet", "testnet-asimov"] }, "chainId": { "type": "integer" },
    "classification": { "const": "INTENTIONALLY_FROZEN" },
    "contractAddress": { "pattern": "^0x[0-9a-fA-F]{40}$" }, "deploymentTransaction": { "pattern": "^0x[0-9a-fA-F]{64}$" },
    "deployer": { "pattern": "^0x[0-9a-fA-F]{40}$" }, "sourceHash": { "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "deployedAt": { "type": "string", "format": "date-time" }, "constructorArgs": { "type": "array" }
  }
}
